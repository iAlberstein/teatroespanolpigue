# HTTPS redirect
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CDN-LOOP} !cloudflare
RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,QSA]

<IfModule mod_rewrite.c>
  # Si la solicitud es para un archivo o directorio existente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Excluir endpoints de API del fallback SPA
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Excluir extensiones de assets estáticos del fallback SPA
  RewriteCond %{REQUEST_URI} \.(?:css|js|map|json|png|jpe?g|gif|svg|webp|ico|mp4|mp3|wav|ogg|woff2?|ttf|eot)$ [NC]
  RewriteRule ^ - [L]

  # Redirigir todo lo demás a index.html (punto de entrada SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback si mod_rewrite no está disponible
ErrorDocument 404 /index.html
